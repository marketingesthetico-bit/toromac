# Resend - emails desde funciones serverless (api/contact.js, api/quote.js)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=jtoro@marobera.com
SENDER_EMAIL=Toromac <noreply@toromac.com>

# GitHub - usado por api/publish-article.js para hacer commit de articulos generados por n8n
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=marketingesthetico-bit/toromac

# Bearer token que valida las peticiones entrantes desde n8n
PUBLISH_SECRET=cambiame-por-un-secreto-largo

# Google Analytics 4 - Measurement ID (publico, expuesto al cliente con prefijo VITE_)
VITE_GA_ID=G-XXXXXXXXXX

# Google Search Console - codigo de verificacion (publico, expuesto al cliente con prefijo VITE_)
# Alternativa: verificacion por DNS (TXT record) -- si lo verificas por DNS, deja vacio.
VITE_GSC_VERIFICATION=
